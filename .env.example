# Example environment variables for QOUTEX-BOT

# Quotex URL (regional may vary)
QUOTEX_URL=https://quotex.com
STORAGE_STATE=storageState.json
SIGNALS_STATE=signals_state.json

# Strategy parameters
SHORT_SMA=7
LONG_SMA=21
ATR_PERIOD=14
ATR_THRESHOLD_PCT=0.01

# Playwright
HEADLESS=false
DEBUG_WS=false

# Optional: limit assets processed (comma-separated)
ALLOWED_ASSETS=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
